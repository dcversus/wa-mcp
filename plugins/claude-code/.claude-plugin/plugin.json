{
  "name": "wa-mcp",
  "displayName": "WhatsApp channels for Claude Code",
  "description": "WhatsApp as live Claude Code channels — subscribe chats with wa-mcp; every subscribed chat arrives in-session and Claude replies with its 77 MCP tools. Voice notes as /voice dictation included.",
  "version": "0.1.1",
  "author": { "name": "dcversus" },
  "homepage": "https://github.com/dcversus/wa-mcp",
  "repository": "https://github.com/dcversus/wa-mcp",
  "license": "MIT",
  "keywords": ["whatsapp", "mcp", "channel", "messaging", "claude-code"],
  "userConfig": {
    "bridge_url": {
      "type": "string",
      "title": "Bridge URL",
      "description": "wa-mcp daemon URL (default http://127.0.0.1:27777)"
    },
    "bridge_token": {
      "type": "string",
      "title": "Bridge token",
      "description": "Bearer token from ~/.wa-mcp/token",
      "sensitive": true
    }
  }
}
